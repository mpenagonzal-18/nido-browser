{
  "name": "nido-browser", "version": "0.1.0", "private": true,
  "description": "Navegador personal con sesiones efímeras y asistentes aislados",
  "author": "Nido contributors", "license": "MIT", "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts docs *.md",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "smoke": "npm run build && node scripts/smoke.mjs"
  },
  "dependencies": { "@ghostery/adblocker-electron": "2.20.3", "zod": "^4.0.0" },
  "devDependencies": { "electron": "45.2.1", "electron-builder": "^26.0.0", "esbuild": "^0.27.0", "typescript": "^5.9.0", "vitest": "^4.0.0", "eslint": "^9.0.0", "@eslint/js": "^9.0.0", "typescript-eslint": "^8.0.0", "prettier": "^3.0.0", "@types/node": "^24.0.0" },
  "build": {
    "appId": "io.nido.browser", "productName": "Nido", "asar": true,
    "files": ["dist/**/*", "assets/**/*", "package.json"],
    "directories": { "output": "release" },
    "mac": { "category": "public.app-category.navigation", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis"] }, "linux": { "target": ["AppImage", "deb"], "category": "Network" }
  }
}
